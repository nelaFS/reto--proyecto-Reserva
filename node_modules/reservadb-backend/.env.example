NODE_ENV=development
PORT=3000
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/reservadb
DATABASE_SSL=false
DATABASE_CONNECTION_LIMIT=10
JWT_SECRET=replace-with-a-long-random-secret
JWT_ISSUER=reservadb-api
JWT_AUDIENCE=reservadb-client
JWT_EXPIRES_IN=1h
