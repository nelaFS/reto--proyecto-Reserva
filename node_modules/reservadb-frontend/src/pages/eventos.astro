---
import BaseLayout from '../layouts/BaseLayout.astro'
import SiteHeader from '../components/SiteHeader.astro'
---
<BaseLayout title="Eventos">
  <main class="grain min-h-screen"><SiteHeader /><section class="mx-auto max-w-7xl px-6 py-12 md:px-10 md:py-20"><p class="eyebrow text-coral">Agenda de la casa</p><h1 class="mt-4 max-w-3xl font-display text-7xl leading-[0.85] text-cream">Noches que<br /><em class="text-coral">merecen quedarse.</em></h1><div id="events-list" class="mt-12 grid gap-5 md:grid-cols-2"><p class="text-muted-cream">Cargando eventos...</p></div></section></main>
</BaseLayout>
<script>
  import { getPublicContent } from '../lib/api/public'
  const list = document.querySelector('#events-list')
  void getPublicContent('eventos').then(({ data }) => { if (!list) return; list.innerHTML = data.map((item) => `<article class="overflow-hidden rounded-2xl border border-cream/15 bg-plum-900/60"><img src="${String(item.imagen)}" alt="${String(item.nombre)}" class="h-56 w-full object-cover" /><div class="p-7"><p class="eyebrow text-coral">${String(item.fecha)} · ${String(item.hora).slice(0, 5)}</p><h2 class="mt-4 font-display text-4xl text-cream">${String(item.nombre)}</h2><p class="mt-3 text-sm text-muted-cream">${String(item.descripcion)}</p></div></article>`).join('') }).catch(() => { if (list) list.innerHTML = '<p class="text-muted-cream">Pronto anunciaremos nuevos eventos.</p>' })
</script>
