---
interface Props {
  compact?: boolean
}

const { compact = false } = Astro.props
---
<header class:list={['relative z-10 mx-auto flex w-full max-w-7xl items-center justify-between px-6 py-6 md:px-10', compact && 'border-b border-cream/10']}>
  <a href="/" class="focus-ring eyebrow text-cream no-underline" aria-label="Volver al inicio">Sabino / Cena</a>
  <nav class="flex items-center gap-3 text-sm" aria-label="Navegacion principal">
    <a href="/#experiencia" class="focus-ring hidden text-muted-cream transition hover:text-cream sm:inline">La experiencia</a>
    <a href="/login" data-auth-link class="focus-ring button-quiet">Acceso</a>
    <button type="button" data-logout class="button-quiet hidden">Salir</button>
  </nav>
</header>
<script>
  import { getAccessToken, clearSession } from '../lib/session'
  import { logout } from '../lib/api/auth'

  const authLink = document.querySelector<HTMLElement>('[data-auth-link]')
  const logoutButton = document.querySelector<HTMLButtonElement>('[data-logout]')

  if (getAccessToken()) {
    authLink?.setAttribute('href', '/reservas')
    if (authLink) authLink.textContent = 'Reservas'
    logoutButton?.classList.remove('hidden')
  }

  logoutButton?.addEventListener('click', async () => {
    logoutButton.disabled = true
    try {
      await logout()
    } catch {
      // La sesion local se limpia aunque el token ya haya expirado.
    } finally {
      clearSession()
      window.location.href = '/'
    }
  })
</script>
