<section class="rounded-2xl border border-cream/15 bg-plum-900/60 p-5 sm:p-7" aria-labelledby="form-title">
  <div class="flex items-start justify-between gap-4">
    <div>
      <p class="eyebrow text-coral">Nueva entrada</p>
      <h2 id="form-title" data-form-title class="mt-3 font-display text-4xl text-cream">Registrar reserva</h2>
    </div>
    <span class="rounded-full border border-sage/40 px-3 py-1 text-[0.65rem] font-bold uppercase tracking-[0.12em] text-sage">Sala</span>
  </div>
  <form id="reserva-form" class="mt-7 space-y-5" novalidate>
    <div class="grid gap-5 sm:grid-cols-2">
      <div>
        <label for="nombreCliente" class="mb-2 block text-xs font-bold uppercase tracking-[0.12em] text-muted-cream">Nombre del cliente</label>
        <input id="nombreCliente" name="nombreCliente" class="field" placeholder="Nombre completo" required />
        <p data-error-for="nombreCliente" class="mt-2 min-h-5 text-xs text-coral"></p>
      </div>
      <div>
        <label for="numeroCliente" class="mb-2 block text-xs font-bold uppercase tracking-[0.12em] text-muted-cream">Telefono</label>
        <input id="numeroCliente" name="numeroCliente" class="field" inputmode="tel" placeholder="912 345 678" required />
        <p data-error-for="numeroCliente" class="mt-2 min-h-5 text-xs text-coral"></p>
      </div>
      <div>
        <label for="numeroMesa" class="mb-2 block text-xs font-bold uppercase tracking-[0.12em] text-muted-cream">Numero de mesa</label>
        <input id="numeroMesa" name="numeroMesa" class="field" type="number" min="1" placeholder="4" required />
        <p data-error-for="numeroMesa" class="mt-2 min-h-5 text-xs text-coral"></p>
      </div>
      <div>
        <label for="cantidadPersonas" class="mb-2 block text-xs font-bold uppercase tracking-[0.12em] text-muted-cream">Personas</label>
        <input id="cantidadPersonas" name="cantidadPersonas" class="field" type="number" min="1" max="30" value="2" required />
        <p data-error-for="cantidadPersonas" class="mt-2 min-h-5 text-xs text-coral"></p>
      </div>
      <div>
        <label for="fechaReserva" class="mb-2 block text-xs font-bold uppercase tracking-[0.12em] text-muted-cream">Fecha y hora</label>
        <input id="fechaReserva" name="fechaReserva" class="field" type="datetime-local" required />
        <p data-error-for="fechaReserva" class="mt-2 min-h-5 text-xs text-coral"></p>
      </div>
    </div>
    <div>
      <label for="estadoPedido" class="mb-2 block text-xs font-bold uppercase tracking-[0.12em] text-muted-cream">Estado</label>
      <select id="estadoPedido" name="estadoPedido" class="field">
        <option value="Disponible">Disponible</option>
        <option value="Cancelado">Cancelado</option>
      </select>
      <p data-error-for="estadoPedido" class="mt-2 min-h-5 text-xs text-coral"></p>
    </div>
    <div class="flex flex-wrap gap-3 pt-2">
      <button type="submit" class="button-primary" data-form-submit>Guardar reserva <span aria-hidden="true">↗</span></button>
      <button type="button" class="button-quiet hidden" data-form-cancel>Cancelar edicion</button>
    </div>
    <p data-form-message class="hidden rounded-lg border p-3 text-sm"></p>
  </form>
</section>
