<section class="min-w-0 rounded-2xl border border-cream/15 bg-plum-900/60" aria-labelledby="list-title">
  <div class="border-b border-cream/15 p-5 sm:p-7">
    <div class="flex flex-wrap items-end justify-between gap-4">
      <div>
        <p class="eyebrow text-coral">Libro de sala</p>
        <h2 id="list-title" class="mt-3 font-display text-4xl text-cream">Reservas</h2>
      </div>
      <p data-total class="text-sm text-muted-cream">Cargando...</p>
    </div>
    <form id="filters-form" class="mt-7 grid gap-3 sm:grid-cols-2 lg:grid-cols-[1.2fr_0.75fr_0.65fr_0.8fr_0.8fr_auto]">
      <label class="sr-only" for="filter-name">Buscar por cliente</label>
      <input id="filter-name" name="nombreCliente" class="field" placeholder="Buscar cliente" />
      <label class="sr-only" for="filter-status">Filtrar estado</label>
      <select id="filter-status" name="estado" class="field">
        <option value="">Todos los estados</option>
        <option value="Disponible">Disponible</option>
        <option value="Cancelado">Cancelado</option>
      </select>
      <label class="sr-only" for="filter-table">Filtrar mesa</label>
      <input id="filter-table" name="numeroMesa" type="number" min="1" class="field" placeholder="Mesa" />
      <label class="sr-only" for="filter-from">Desde</label>
      <input id="filter-from" name="fechaDesde" type="date" class="field" aria-label="Fecha desde" />
      <label class="sr-only" for="filter-to">Hasta</label>
      <input id="filter-to" name="fechaHasta" type="date" class="field" aria-label="Fecha hasta" />
      <button type="submit" class="button-quiet">Filtrar</button>
    </form>
  </div>
  <div class="overflow-x-auto">
    <table class="w-full min-w-[720px] text-left text-sm">
      <thead class="border-b border-cream/10 text-[0.65rem] uppercase tracking-[0.14em] text-muted-cream">
        <tr>
          <th class="px-5 py-4 font-bold sm:px-7">Cliente</th>
          <th class="px-5 py-4 font-bold">Mesa</th>
          <th class="px-5 py-4 font-bold">Personas</th>
          <th class="px-5 py-4 font-bold">Fecha</th>
          <th class="px-5 py-4 font-bold">Estado</th>
          <th class="px-5 py-4 font-bold">Accion</th>
        </tr>
      </thead>
      <tbody data-reservas-body class="divide-y divide-cream/10"></tbody>
    </table>
    <div data-empty class="hidden px-6 py-16 text-center">
      <p class="font-display text-3xl text-cream">La sala esta tranquila.</p>
      <p class="mt-2 text-sm text-muted-cream">No encontramos reservas con estos filtros.</p>
    </div>
  </div>
  <div class="flex items-center justify-between border-t border-cream/10 px-5 py-4 sm:px-7">
    <p data-page-label class="text-xs text-muted-cream"></p>
    <div class="flex gap-2">
      <button type="button" data-page-prev class="button-quiet">Anterior</button>
      <button type="button" data-page-next class="button-quiet">Siguiente</button>
    </div>
  </div>
</section>
