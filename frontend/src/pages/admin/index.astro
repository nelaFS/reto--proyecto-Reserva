---
import BaseLayout from '../../layouts/BaseLayout.astro'
import SiteHeader from '../../components/SiteHeader.astro'
---
<BaseLayout title="Administracion">
  <main class="grain min-h-screen"><SiteHeader compact /><section class="mx-auto max-w-7xl px-6 py-12 md:px-10 md:py-16"><p class="eyebrow text-coral">Panel privado</p><h1 class="mt-4 font-display text-7xl text-cream">Administrar<br /><em class="text-coral">la casa.</em></h1><div class="mt-12 grid gap-6 lg:grid-cols-2">
    <section class="rounded-2xl border border-cream/15 bg-plum-900/60 p-6" data-resource="mesas"><div class="flex items-center justify-between"><h2 class="font-display text-4xl text-cream">Mesas</h2><button type="button" data-load="mesas" class="button-quiet">Actualizar</button></div><form data-form="mesas" class="mt-5 space-y-3"><textarea data-payload="mesas" class="field min-h-28 font-mono text-xs" spellcheck="false"></textarea><button type="submit" class="button-primary">Crear mesa</button></form><div data-list="mesas" class="mt-5 space-y-2 text-sm text-muted-cream"><p>Sin cargar datos.</p></div></section>
    <section class="rounded-2xl border border-cream/15 bg-plum-900/60 p-6" data-resource="menu"><div class="flex items-center justify-between"><h2 class="font-display text-4xl text-cream">Menu</h2><button type="button" data-load="menu" class="button-quiet">Actualizar</button></div><form data-form="menu" class="mt-5 space-y-3"><textarea data-payload="menu" class="field min-h-28 font-mono text-xs" spellcheck="false"></textarea><button type="submit" class="button-primary">Crear plato</button></form><div data-list="menu" class="mt-5 space-y-2 text-sm text-muted-cream"><p>Sin cargar datos.</p></div></section>
    <section class="rounded-2xl border border-cream/15 bg-plum-900/60 p-6" data-resource="eventos"><div class="flex items-center justify-between"><h2 class="font-display text-4xl text-cream">Eventos</h2><button type="button" data-load="eventos" class="button-quiet">Actualizar</button></div><form data-form="eventos" class="mt-5 space-y-3"><textarea data-payload="eventos" class="field min-h-28 font-mono text-xs" spellcheck="false"></textarea><button type="submit" class="button-primary">Crear evento</button></form><div data-list="eventos" class="mt-5 space-y-2 text-sm text-muted-cream"><p>Sin cargar datos.</p></div></section>
    <section class="rounded-2xl border border-cream/15 bg-plum-900/60 p-6" data-resource="promociones"><div class="flex items-center justify-between"><h2 class="font-display text-4xl text-cream">Promociones</h2><button type="button" data-load="promociones" class="button-quiet">Actualizar</button></div><form data-form="promociones" class="mt-5 space-y-3"><textarea data-payload="promociones" class="field min-h-28 font-mono text-xs" spellcheck="false"></textarea><button type="submit" class="button-primary">Crear promocion</button></form><div data-list="promociones" class="mt-5 space-y-2 text-sm text-muted-cream"><p>Sin cargar datos.</p></div></section>
  </div></section></main>
</BaseLayout>
<script>
  import { request } from '../../lib/api/client'
  import { getAccessToken } from '../../lib/session'
  const resources = ['mesas', 'menu', 'eventos', 'promociones'] as const
  const defaults: Record<typeof resources[number], string> = { mesas: '{"numeroMesa":11,"capacidad":4,"estado":"Disponible"}', menu: '{"nombre":"Nuevo plato","descripcion":"Descripcion","imagen":"/images/menu/majadito.svg","precio":45,"categoria":"Especial","disponible":true}', eventos: '{"nombre":"Nuevo evento","descripcion":"Descripcion","imagen":"/images/events/jazz.svg","fecha":"2026-11-01","hora":"20:00:00","estado":"Activo"}', promociones: '{"titulo":"Nueva promocion","descripcion":"Descripcion","imagen":"/images/promos/dos.svg","descuento":10,"fechaInicio":"2026-11-01","fechaFin":"2026-11-30","estado":"Activa"}' }
  if (!getAccessToken()) window.location.replace('/login')
  resources.forEach((resource) => { const textarea = document.querySelector<HTMLTextAreaElement>(`[data-payload="${resource}"]`); if (textarea) textarea.value = defaults[resource] })
  async function load(resource: typeof resources[number]) { const response = await request<{ data: Array<Record<string, unknown>> }>(`/api/${resource}`); const list = document.querySelector<HTMLElement>(`[data-list="${resource}"]`); if (list) { list.replaceChildren(); response.data.forEach((item) => { const row = document.createElement('div'); row.className = 'flex items-center justify-between gap-3 rounded-lg border border-cream/10 p-3'; const name = document.createElement('span'); name.textContent = String(item.nombre ?? item.titulo ?? `Mesa ${item.numeroMesa}`); const actions = document.createElement('div'); actions.className = 'flex gap-3'; const edit = document.createElement('button'); edit.type = 'button'; edit.className = 'text-xs font-bold uppercase text-cream'; edit.textContent = 'Editar'; edit.addEventListener('click', () => { const textarea = document.querySelector<HTMLTextAreaElement>(`[data-payload="${resource}"]`); const form = document.querySelector<HTMLFormElement>(`[data-form="${resource}"]`); if (textarea && form) { textarea.value = JSON.stringify(item, null, 2); form.dataset.editId = String(item.identificador); textarea.focus() } }); const remove = document.createElement('button'); remove.type = 'button'; remove.className = 'text-xs font-bold uppercase text-coral'; remove.textContent = 'Eliminar'; remove.addEventListener('click', async () => { await request(`/api/${resource}/${item.identificador}`, { method: 'DELETE' }); await load(resource) }); actions.append(edit, remove); row.append(name, actions); list.append(row) }) } }
  resources.forEach((resource) => { void load(resource); document.querySelector(`[data-load="${resource}"]`)?.addEventListener('click', () => void load(resource)); document.querySelector<HTMLFormElement>(`[data-form="${resource}"]`)?.addEventListener('submit', async (event) => { event.preventDefault(); const textarea = document.querySelector<HTMLTextAreaElement>(`[data-payload="${resource}"]`); const form = event.currentTarget as HTMLFormElement; if (!textarea) return; try { JSON.parse(textarea.value); const id = form.dataset.editId; await request(id ? `/api/${resource}/${id}` : `/api/${resource}`, { method: id ? 'PATCH' : 'POST', body: textarea.value }); delete form.dataset.editId; await load(resource) } catch (error) { alert(error instanceof Error ? error.message : 'No se pudo guardar el registro.') } }) })
</script>
