---
import BaseLayout from '../layouts/BaseLayout.astro'
import SiteHeader from '../components/SiteHeader.astro'
---
<BaseLayout title="Promociones">
  <main class="grain min-h-screen"><SiteHeader /><section class="mx-auto max-w-7xl px-6 py-12 md:px-10 md:py-20"><p class="eyebrow text-coral">Para compartir más</p><h1 class="mt-4 font-display text-7xl text-cream">Promociones</h1><div id="promos-list" class="mt-12 grid gap-5 md:grid-cols-2"><p class="text-muted-cream">Cargando promociones...</p></div></section></main>
</BaseLayout>
<script>
  import { getPublicContent } from '../lib/api/public'
  const list = document.querySelector('#promos-list')
  void getPublicContent('promociones').then(({ data }) => { if (!list) return; list.innerHTML = data.map((item) => `<article class="flex min-h-64 flex-col justify-between rounded-2xl border border-coral/35 bg-coral/10 p-7"><div><p class="eyebrow text-coral">${String(item.descuento)}% de descuento</p><h2 class="mt-4 font-display text-5xl text-cream">${String(item.titulo)}</h2><p class="mt-3 max-w-lg text-sm text-muted-cream">${String(item.descripcion)}</p></div><p class="mt-8 text-xs uppercase tracking-[0.12em] text-muted-cream">${String(item.fechaInicio)} — ${String(item.fechaFin)}</p></article>`).join('') }).catch(() => { if (list) list.innerHTML = '<p class="text-muted-cream">Pronto anunciaremos nuevas promociones.</p>' })
</script>
