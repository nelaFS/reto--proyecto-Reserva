---
import BaseLayout from '../layouts/BaseLayout.astro'
import SiteHeader from '../components/SiteHeader.astro'
---
<BaseLayout title="Reservar mesa">
  <main class="grain min-h-screen"><SiteHeader compact /><section class="mx-auto max-w-5xl px-6 py-12 md:px-10 md:py-20"><div class="mb-10"><p class="eyebrow text-coral">Tu mesa en Santa Cruz</p><h1 class="mt-4 font-display text-7xl leading-[0.85] text-cream">Reserva<br /><em class="text-coral">tu momento.</em></h1><p class="mt-6 max-w-lg text-muted-cream">Elige tu fecha, encuentra la mesa ideal y déjanos preparar la noche.</p></div><form id="public-reservation" class="grid gap-7 rounded-[2rem] border border-cream/15 bg-plum-900/60 p-6 sm:p-10" novalidate><div class="grid gap-5 sm:grid-cols-2"><label class="text-xs font-bold uppercase tracking-[0.12em] text-muted-cream">Fecha y hora<input id="public-date" type="datetime-local" class="field mt-2" required /></label><label class="text-xs font-bold uppercase tracking-[0.12em] text-muted-cream">Personas<input id="public-people" type="number" min="1" max="30" value="2" class="field mt-2" required /></label></div><div><p class="text-xs font-bold uppercase tracking-[0.12em] text-muted-cream">Mesas disponibles</p><div id="available-tables" class="mt-3 grid gap-3 sm:grid-cols-3"><p class="rounded-xl border border-cream/10 p-4 text-sm text-muted-cream">Selecciona fecha y personas.</p></div></div><div class="grid gap-5 sm:grid-cols-2"><label class="text-xs font-bold uppercase tracking-[0.12em] text-muted-cream">Nombre<input id="public-name" class="field mt-2" placeholder="Tu nombre" required /></label><label class="text-xs font-bold uppercase tracking-[0.12em] text-muted-cream">Telefono<input id="public-phone" class="field mt-2" placeholder="721 234 56" required /></label></div><p id="reservation-error" class="hidden rounded-lg border border-coral/30 bg-coral/10 p-3 text-sm text-coral"></p><button class="button-primary w-full sm:w-fit" type="submit" id="public-submit">Confirmar reserva ↗</button></form><div id="reservation-summary" class="mt-7 hidden rounded-[2rem] border border-sage/40 bg-sage/10 p-7"></div></section></main>
</BaseLayout>
<script>
  import { createPublicReservation, getAvailableTables, type MesaDisponible } from '../lib/api/public'
  import { reservaFormSchema } from '../lib/schemas'
  const form = document.querySelector<HTMLFormElement>('#public-reservation')
  const date = document.querySelector<HTMLInputElement>('#public-date')
  const people = document.querySelector<HTMLInputElement>('#public-people')
  const tables = document.querySelector<HTMLElement>('#available-tables')
  const error = document.querySelector<HTMLElement>('#reservation-error')
  const summary = document.querySelector<HTMLElement>('#reservation-summary')
  let selectedTable: MesaDisponible | null = null
  function renderTables(items: MesaDisponible[]) { if (!tables) return; tables.replaceChildren(); if (!items.length) { tables.innerHTML = '<p class="rounded-xl border border-coral/30 bg-coral/10 p-4 text-sm text-coral sm:col-span-3">No hay mesas disponibles para ese horario.</p>'; return } items.forEach((item) => { const button = document.createElement('button'); button.type = 'button'; button.className = 'rounded-xl border border-cream/15 p-4 text-left transition hover:border-coral'; button.innerHTML = `<span class="font-display text-3xl text-cream">Mesa ${item.numeroMesa}</span><span class="mt-1 block text-xs text-muted-cream">Hasta ${item.capacidad} personas</span>`; button.addEventListener('click', () => { selectedTable = item; document.querySelectorAll('#available-tables button').forEach((b) => b.classList.remove('border-coral', 'bg-coral/10')); button.classList.add('border-coral', 'bg-coral/10') }); tables.append(button) }) }
  async function refreshTables() { if (!date?.value || !people?.value) return; try { renderTables((await getAvailableTables(date.value.replace('T', ' ') + ':00', Number(people.value))).data) } catch { renderTables([]) } }
  date?.addEventListener('change', refreshTables); people?.addEventListener('change', refreshTables)
  form?.addEventListener('submit', async (event) => { event.preventDefault(); if (!date?.value || !people?.value || !selectedTable) { if (error) { error.textContent = 'Selecciona fecha, personas y una mesa.'; error.classList.remove('hidden') }; return } const input = { nombreCliente: document.querySelector<HTMLInputElement>('#public-name')?.value ?? '', numeroCliente: document.querySelector<HTMLInputElement>('#public-phone')?.value ?? '', estadoPedido: 'Disponible' as const, numeroMesa: selectedTable.numeroMesa, cantidadPersonas: Number(people.value), fechaReserva: date.value }; const parsed = reservaFormSchema.safeParse(input); if (!parsed.success) { if (error) { error.textContent = parsed.error.issues[0]?.message ?? 'Revisa los datos.'; error.classList.remove('hidden') }; return } const apiInput = { ...parsed.data, fechaReserva: parsed.data.fechaReserva.replace('T', ' ') + ':00' }; try { const result = await createPublicReservation(apiInput); form.classList.add('hidden'); if (summary) { summary.innerHTML = `<p class="eyebrow text-sage">Reserva confirmada</p><h2 class="mt-4 font-display text-5xl text-cream">Te esperamos.</h2><p class="mt-4 text-muted-cream">${result.data.nombreCliente}, tu mesa ${result.data.numeroMesa} esta reservada para ${result.data.cantidadPersonas} personas el ${result.data.fechaReserva}.</p>`; summary.classList.remove('hidden') } } catch (e) { if (error) { error.textContent = e instanceof Error ? e.message : 'No se pudo confirmar la reserva.'; error.classList.remove('hidden') } } })
</script>
